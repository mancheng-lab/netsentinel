# Nmap 可执行文件路径（Windows 未加入 PATH 时必填）
# NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe

# 是否允许扫描公网地址（默认 0，严禁随意开启）
# ALLOW_PUBLIC_SCAN=0

# NVD API Key（可选，提高 CVE 查询速率）
# 免费申请：https://nvd.nist.gov/developers/request-an-api-key
# NVD_API_KEY=

# 数据库路径（默认 data/netsentinel.db）
# NETSENTINEL_DB=data/netsentinel.db
